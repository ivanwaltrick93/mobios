# ---- Usado pelo docker compose ----
POSTGRES_PASSWORD=mobios
APP_DB_PASSWORD=mobios_app
WEB_PORT=8080
# false enquanto o acesso for por http; true atrás de HTTPS.
COOKIE_SECURE=false
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# ---- Usado pelo `pnpm dev` / `pnpm test` na máquina (banco do compose exposto em localhost) ----
# As senhas precisam bater com POSTGRES_PASSWORD e APP_DB_PASSWORD acima.
DATABASE_MIGRATION_URL=postgres://mobios:mobios@localhost:5432/mobios
DATABASE_URL=postgres://mobios_app:mobios_app@localhost:5432/mobios
PORT=3333
NODE_ENV=development
