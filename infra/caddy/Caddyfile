# O Caddy roda sem root, em portas sem privilégio (Kubernetes-ready, docs/ARQUITETURA.md §9): 8080 (HTTP) e
# 8443 (HTTPS). O docker compose publica a porta do servidor nelas.
#
# Para HTTPS em produção, troque ":8080" pelo domínio (ex.: app.mobios.com.br) e publique no compose
# "80:8080" e "443:8443": o Caddy emite e renova o certificado Let's Encrypt automaticamente (o desafio chega pela
# porta 80 do servidor, repassada à 8080).
{
	http_port 8080
	https_port 8443
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3333}
	}

	handle {
		root * /srv
		# SPA: rotas do React Router caem no index.html.
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
